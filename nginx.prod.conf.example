worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 10M;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript 
               application/json application/javascript application/xml+rss 
               application/rss+xml font/truetype font/opentype 
               application/vnd.ms-fontobject image/svg+xml;

    # 图片缓存
    proxy_cache_path /var/cache/nginx/images 
                     levels=1:2 
                     keys_zone=images_cache:50m 
                     max_size=5g 
                     inactive=30d 
                     use_temp_path=off;

    # API 缓存（短时间）
    proxy_cache_path /var/cache/nginx/api 
                     levels=1:2 
                     keys_zone=api_cache:10m 
                     max_size=100m 
                     inactive=10m 
                     use_temp_path=off;

    # 限流配置
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=upload_limit:10m rate=5r/m;

    upstream api_backend {
        server api:8080 max_fails=3 fail_timeout=30s;
        keepalive 32;
    }

    upstream imgproxy_backend {
        server imgproxy:8080 max_fails=3 fail_timeout=30s;
        keepalive 32;
    }

    # API 服务器
    server {
        listen 80;
        server_name api.yourdomain.com;  # 修改为你的 API 域名

        # 强制 HTTPS（生产环境推荐）
        # return 301 https://$server_name$request_uri;

        # 或者直接配置 HTTP（开发/测试）
        location / {
            limit_req zone=api_limit burst=20 nodelay;
            
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_cache_bypass $http_upgrade;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # 图片上传接口（单独限流）
        location /api/v1/images/upload {
            limit_req zone=upload_limit burst=5 nodelay;
            
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_request_buffering off;
            proxy_buffering off;
        }
    }

    # 图片服务器
    server {
        listen 80;
        server_name image.yourdomain.com;  # 修改为你的图片域名

        # 强制 HTTPS（生产环境推荐）
        # return 301 https://$server_name$request_uri;

        # 图片动态转换（通过 imgproxy）
        location / {
            set $width $arg_w;
            set $format $arg_format;
            set $quality $arg_q;
            set $imgproxy_url "plain/local:///";
            
            # 构建 imgproxy URL
            if ($width != "") {
                set $imgproxy_url "resize:fill:${width}:0:0/plain/local:///";
            }
            
            if ($format = "webp") {
                set $imgproxy_url "${imgproxy_url}$uri@webp";
            }
            if ($format != "webp") {
                set $imgproxy_url "${imgproxy_url}$uri";
            }

            # 代理到 imgproxy
            proxy_pass http://imgproxy_backend/$imgproxy_url;
            
            # 缓存配置
            proxy_cache images_cache;
            proxy_cache_key "$uri$is_args$args";
            proxy_cache_valid 200 30d;
            proxy_cache_valid 404 1m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;
            add_header X-Cache-Status $upstream_cache_status;

            # 头部设置
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass_request_headers on;
            
            add_header Cache-Control "public, max-age=2592000, immutable";
            add_header Access-Control-Allow-Origin "*";
            add_header Vary "Accept";
            
            # 忽略上游的缓存头
            proxy_ignore_headers Set-Cookie Cache-Control Expires;
            
            # 安全头
            add_header X-Content-Type-Options "nosniff";
            add_header X-Frame-Options "SAMEORIGIN";
        }
    }

    # HTTPS 配置示例（使用 Let's Encrypt）
    # server {
    #     listen 443 ssl http2;
    #     server_name api.yourdomain.com;
    #
    #     ssl_certificate /etc/letsencrypt/live/api.yourdomain.com/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/api.yourdomain.com/privkey.pem;
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #     ssl_session_cache shared:SSL:10m;
    #     ssl_session_timeout 10m;
    #
    #     # ... API 配置同上 ...
    # }
    #
    # server {
    #     listen 443 ssl http2;
    #     server_name image.yourdomain.com;
    #
    #     ssl_certificate /etc/letsencrypt/live/image.yourdomain.com/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/image.yourdomain.com/privkey.pem;
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #
    #     # ... 图片配置同上 ...
    # }
}
