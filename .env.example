# Database Configuration (Docker Compose 会自动构建连接字符串)
DB_USER=blog
DB_PASSWORD=change_this_strong_password
DB_NAME=blog

# JWT Configuration
JWT_SECRET=change_this_to_a_random_64_character_string

# Database Connection Settings
DB_MAX_RETRIES=5
DB_RETRY_DELAY_SECONDS=3

# Application Settings
GIN_MODE=release
# Storage Configuration
# 存储后端类型: filesystem (暂时仅支持文件系统)
STORAGE_BACKEND=filesystem

# 文件系统存储配置
# 文件存储路径（相对于应用根目录或绝对路径）
STORAGE_FS_BASE_PATH=./uploads
# 文件访问完整 URL 前缀（用于生成图片访问链接）
# 生产环境示例: https://image.yourdomain.com 或 https://cdn.example.com/images
# 本地开发示例: http://localhost:8080/uploads
STORAGE_FS_BASE_URL=http://localhost:8080/uploads